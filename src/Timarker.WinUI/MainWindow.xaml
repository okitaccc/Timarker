<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Timarker_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Timarker_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="事刻 Timarker"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="BackgroundImage" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed" />
        <TitleBar
            x:Name="AppTitleBar"
            Title="事刻 Timarker"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            CompactPaneLength="48"
            Background="Transparent"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="8,8,0,12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="事刻" />
                    <TextBlock Opacity="0.62" Text="TIMARKER" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="今日"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日历" Tag="calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="项目" Tag="projects"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="收藏夹" Tag="folders"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="记录" Tag="records"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70B;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="便签" Tag="notes"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70D;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="番茄钟" Tag="pomodoro"><NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
        <InfoBar x:Name="ReminderBar" Grid.Row="1" Margin="20" MaxWidth="480" HorizontalAlignment="Right" VerticalAlignment="Top" Severity="Informational" Title="Timarker 提醒" IsOpen="False" IsClosable="True">
            <InfoBar.Content><StackPanel Spacing="10"><TextBlock x:Name="ReminderText" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="稍后提醒" Click="SnoozeReminder_Click"/><Button Style="{StaticResource AccentButtonStyle}" Content="完成" Click="CompleteReminder_Click"/></StackPanel></StackPanel></InfoBar.Content>
        </InfoBar>
    </Grid>
</Window>
