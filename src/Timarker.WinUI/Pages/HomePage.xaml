<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Timarker_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Timarker_WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="今日与未来" />
                <TextBlock Margin="0,4,0,0" Opacity="0.62" Text="把值得记住的时刻，放在清晰的时间线上。" />
            </StackPanel>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="NewEvent_Click">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="新建事项" /></StackPanel>
            </Button>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="快速创建" />
                    <TextBox x:Name="QuickTitleBox" Header="事项名称" PlaceholderText="例如：明天下午三点开会" />
                    <ComboBox Header="事项用途" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="普通事项" /><ComboBoxItem Content="周期事项" /><ComboBoxItem Content="生日" /><ComboBoxItem Content="纪念日" />
                    </ComboBox>
                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Content="继续设置" Click="NewEvent_Click" />
                    <Border Margin="0,8,0,0" Padding="14" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Spacing="5"><TextBlock FontWeight="SemiBold" Text="今天的节奏" /><TextBlock Opacity="0.7" Text="先完成最重要的一件事。" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="FilterBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="全部事项" Tag="all" /><ComboBoxItem Content="待处理" Tag="pending" /><ComboBoxItem Content="已完成" Tag="done" />
                    </ComboBox>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索标题或词条" QuerySubmitted="Search_QuerySubmitted" TextChanged="Search_TextChanged" />
                    <Button Grid.Column="2" Content="搜索" Click="Search_Click" />
                </Grid>
                <ListView x:Name="EventList" Grid.Row="1" ItemsSource="{x:Bind VisibleEvents, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Event_Click">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:EventCardViewModel">
                            <Border Padding="18,15" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="编辑" Icon="Edit" Click="EditEvent_Click"/><MenuFlyoutItem Text="完成" Icon="Accept" Click="CompleteEvent_Click"/><MenuFlyoutItem Text="加入收藏夹" Icon="Add" Click="AddToFolder_Click"/><MenuFlyoutSeparator /><MenuFlyoutItem Text="删除" Icon="Delete" Click="DeleteEvent_Click"/>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Background="{x:Bind AccentBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Opacity="0.66" Text="{x:Bind Meta}" />
                                        <ItemsControl ItemsSource="{x:Bind Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Padding="8,3" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock FontSize="12" Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Center" Content="倒计时" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Header><TextBlock x:Name="CountText" Margin="2,0,0,12" FontWeight="SemiBold" /></ListView.Header>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
