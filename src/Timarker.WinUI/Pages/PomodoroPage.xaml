<?xml version="1.0" encoding="utf-8"?><Page x:Class="Timarker_WinUI.Pages.PomodoroPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Padding="28,20,28,24"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22"><TextBlock HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="番茄钟"/><TextBlock x:Name="ModeText" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Text="专注中"/><TextBlock x:Name="ClockText" HorizontalAlignment="Center" FontSize="76" FontWeight="SemiBold" Text="25:00"/><StackPanel Orientation="Horizontal" Spacing="12"><NumberBox x:Name="FocusBox" Header="专注（分钟）" Width="130" Value="25" Minimum="1" Maximum="180"/><NumberBox x:Name="BreakBox" Header="休息（分钟）" Width="130" Value="5" Minimum="1" Maximum="60"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Content="开始" Click="Start_Click"/><Button Content="重置" Click="Reset_Click"/><Button Content="切换专注/休息" Click="Switch_Click"/></StackPanel></StackPanel></Grid></Page>
