<?xml version="1.0" encoding="utf-8"?><Page x:Class="Timarker_WinUI.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28,20,28,28" Spacing="18"><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置"/><TextBlock Margin="0,-12,0,8" Opacity="0.62" Text="调整 Timarker 的外观与提醒习惯。"/><Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16"><TextBlock FontSize="18" FontWeight="SemiBold" Text="外观"/><ComboBox x:Name="ThemeBox" Header="颜色模式" SelectedIndex="0" SelectionChanged="Theme_Changed"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BackgroundPath" Header="主窗口背景" PlaceholderText="未选择图片" IsReadOnly="True"/><Button Grid.Column="1" VerticalAlignment="Bottom" Content="选择图片" Click="PickBackground_Click"/></Grid><Slider x:Name="OpacitySlider" Header="背景透明度" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Opacity_Changed"/><Button HorizontalAlignment="Left" Content="清除背景" Click="ClearBackground_Click"/></StackPanel></Border><Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="14"><TextBlock FontSize="18" FontWeight="SemiBold" Text="提醒"/><ToggleSwitch x:Name="QuietSwitch" Header="启用免打扰时段" Toggled="Setting_Changed"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TimePicker x:Name="QuietStart" Header="开始" ClockIdentifier="24HourClock" SelectedTimeChanged="Time_Changed"/><TimePicker x:Name="QuietEnd" Grid.Column="1" Header="结束" ClockIdentifier="24HourClock" SelectedTimeChanged="Time_Changed"/></Grid><NumberBox x:Name="SnoozeBox" Header="默认稍后提醒（分钟）" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" ValueChanged="Number_Changed"/></StackPanel></Border><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="开机自启与系统托盘" Message="迁移到打包版后将使用 Windows 的 StartupTask 与 AppLifecycle 接入，旧版设置在此之前继续有效。"/></StackPanel></ScrollViewer></Page>
