<?xml version="1.0" encoding="utf-8"?><Page x:Class="Timarker_WinUI.Pages.NotesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Padding="28,20,28,24" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="便签"/><TextBlock Margin="0,4,0,0" Opacity="0.62" Text="先记下来，需要时再整理成行动。"/></StackPanel><AutoSuggestBox x:Name="SearchBox" Width="280" HorizontalAlignment="Right" VerticalAlignment="Center" PlaceholderText="搜索便签" TextChanged="Search_Changed"/></Grid><Grid Grid.Row="1" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Margin="0,0,0,10" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Content="新建便签" Click="Add_Click"/><ListView x:Name="NoteList" Grid.Row="1" SelectionChanged="Note_Changed"><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Content}" MaxLines="2" TextTrimming="CharacterEllipsis" Opacity="0.62"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid><Border Grid.Column="1" Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid x:Name="Editor" Visibility="Collapsed" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="NoteTitle" PlaceholderText="便签标题" FontSize="19" FontWeight="SemiBold" TextChanged="Editor_Changed"/><TextBox x:Name="NoteContent" Grid.Row="1" PlaceholderText="从这里开始记录……" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="Editor_Changed"/><CommandBar Grid.Row="2" Background="Transparent" DefaultLabelPosition="Right"><AppBarToggleButton x:Name="PinButton" Label="置顶" Icon="Pin" Click="Pin_Click"/><AppBarButton Label="悬浮到桌面" Icon="OpenInNewWindow" Click="Float_Click"/><AppBarSeparator/><AppBarButton Label="删除" Icon="Delete" Click="Delete_Click"/></CommandBar></Grid></Border></Grid></Grid></Page>
