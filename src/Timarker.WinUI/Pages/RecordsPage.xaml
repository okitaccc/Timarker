<?xml version="1.0" encoding="utf-8"?><Page x:Class="Timarker_WinUI.Pages.RecordsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Padding="28,20,28,24" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="记录"/><TextBlock Margin="0,4,0,0" Opacity="0.62" Text="留下今天完成了什么。"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="补一条记录" Click="Add_Click"/></Grid><ListView x:Name="RecordList" Grid.Row="1"><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,10" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock FontWeight="SemiBold" FontSize="16" Text="{Binding Title}"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.72"/><TextBlock Text="{Binding OccurredAt}" Opacity="0.5"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Page>
